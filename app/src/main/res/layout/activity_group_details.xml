<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_teal"
        android:orientation="vertical"
        android:padding="24dp">


        <!-- Settings Button -->
        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="16dp"
            android:text="Back" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_settings"
            android:background="@android:color/transparent"
            android:contentDescription="Group Settings"
            android:visibility="gone" />

        <!-- Group Name -->
        <TextView
            android:id="@+id/groupDetailsName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Group Name"
            android:textColor="@color/dark_beige"
            android:textSize="32sp"
            android:textStyle="bold|italic" />

        <!-- Group Bio -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="About This Group"
            android:textColor="@color/dark_violet"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/groupDetailsBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Group biography will appear here."
            android:textColor="@color/beige"
            android:textSize="20sp" />

        <!-- Group Information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Group Information"
            android:textColor="@color/dark_violet"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/groupDetailsGenre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Genre:"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/groupDetailsBook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Currently Reading:"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/groupDetailsBookLength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Book Length:"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/groupDetailsCommunication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Communication Method:"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/groupDetailsSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Members:"
            android:textSize="20sp" />

        <!-- Join Request Button -->
        <Button
            android:id="@+id/requestJoinButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Request to Join" />


    </LinearLayout>
</ScrollView>