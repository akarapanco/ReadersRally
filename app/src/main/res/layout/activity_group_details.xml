<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">



        <!-- Group Name -->
        <TextView
            android:id="@+id/groupDetailsName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Group Name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <!-- Group Biography -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="About This Group"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <TextView
            android:id="@+id/groupDetailsBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Group biography will appear here."
            android:textSize="16sp"
            android:textColor="#555555" />

        <!-- Group Information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Group Information"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <TextView
            android:id="@+id/groupDetailsGenre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Genre:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/groupDetailsBook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Currently Reading:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/groupDetailsBookLength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Book Length:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/groupDetailsCommunication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Communication Method:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/groupDetailsSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Members:"
            android:textSize="16sp" />

        <!-- Join Request Button -->
        <Button
            android:id="@+id/requestJoinButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Request to Join" />

    </LinearLayout>
</ScrollView>